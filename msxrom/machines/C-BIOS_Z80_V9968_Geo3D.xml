<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig><!-- Derived from official openMSX 21.0 via renatus-xxxx/openmsx-v9968-windows-setup C-BIOS_V9968_JP.xml (VDP block for V9968). Modified: Geo3D device added after the VDP (same block as alexmoncks/openMSX share/extensions/geo3d.xml, MIT). GPL; see doc/GPL.txt. -->

  <info>
    <manufacturer>C-BIOS</manufacturer>
    <code>MSX2+ JP V9968 + Geo3D (Z80)</code>
    <release_year>2010</release_year>
    <description>An MSX2+ (Z80) machine using C-BIOS with the V9968 VDP and the Geo3D coprocessor built in (ports 9Dh/9Fh), MSX-MUSIC, a Japanese keyboard layout and 60Hz interrupt frequency. Do not add -ext geo3d.</description>
    <type>MSX2+</type>
  </info>

  <MapperReadBackBits>largest</MapperReadBackBits>

  <CassettePort/>

  <devices>

    <primary slot="0">
      <ROM id="C-BIOS Main ROM JP">
        <mem base="0x0000" size="0x8000"/>
        <rom>
          <sha1>a5b02ea4a1530f2b96f0f4f4e2049f0de4a31e5a</sha1>
          <filename>cbios_main_msx2+_jp.rom</filename>
        </rom>
      </ROM>

      <ROM id="C-BIOS Logo ROM">
        <mem base="0x8000" size="0x4000"/>
        <rom>
          <sha1>db2635ef7e3f8589518dca65f2e3b515edc5372d</sha1>
          <filename>cbios_logo_msx2+.rom</filename>
        </rom>
      </ROM>
    </primary>

    <primary external="true" slot="1"/>

    <primary external="true" slot="2"/>

    <primary slot="3">

      <secondary slot="0">
        <ROM id="C-BIOS Sub ROM">
          <mem base="0x0000" size="0x4000"/>
          <rom>
            <sha1>2fcb40413e7d373f0f2dbdc815ce18746ddf3684</sha1>
            <filename>cbios_sub.rom</filename>
          </rom>
        </ROM>
      </secondary>

      <secondary slot="1">
        <MSX-MUSIC id="C-BIOS MSX-MUSIC">
          <mem base="0x4000" size="0x4000"/>
          <io base="0x7C" num="2" type="O"/>
          <rom>
            <sha1>5c5eb001e6a1fe29edb7abd428a3967bb388e5db</sha1>
            <filename>cbios_music.rom</filename>
          </rom>
          <sound>
            <volume>9000</volume>
          </sound>
        </MSX-MUSIC>
      </secondary>

      <secondary slot="2">
        <MemoryMapper id="Main RAM">
          <mem base="0x0000" size="0x10000"/>
          <size>512</size>
        </MemoryMapper>
      </secondary>

    </primary>

    <PPI id="ppi">
      <io base="0xA8" num="4"/>
      <sound>
        <volume>16000</volume>
      </sound>
      <key_ghosting>false</key_ghosting>
      <keyboard_type>jp_ansi</keyboard_type>
      <has_keypad>true</has_keypad>
      <code_kana_locks>true</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>

    <VDP id="VDP"><version>V9968</version><vram>128</vram><io base="0x98" num="5" type="O"/><io base="0x98" num="5" type="I"/><timing>0</timing></VDP>

    <Geo3D id="geo3d">
      <io base="0x9D" num="1" type="IO"/>
      <io base="0x9F" num="1" type="IO"/>
      <vdp>VDP</vdp>
    </Geo3D>


    <PSG id="PSG">
      <type>YM2149</type>
      <keyboardlayout>50on</keyboardlayout>
      <io base="0xA0" num="4" type="IO"/>
      <sound>
        <volume>21000</volume>
      </sound>
    </PSG>

    <RTC id="Real time clock">
      <io base="0xB4" num="2" type="O"/>
      <io base="0xB5" num="1" type="I"/>
      <sramname>cbios-msx2+_jp.cmos</sramname>
    </RTC>

    <PrinterPort id="Printer Port">
      <io base="0x90" num="2"/>
    </PrinterPort>

    <ResetStatusRegister id="Reset Status register">
      <io base="0xF4" num="1"/>
      <inverted>true</inverted>
    </ResetStatusRegister>

  </devices>

</msxconfig>
