<?xml version="1.0"?>
<!DOCTYPE msxconfig SYSTEM "msxconfig2.dtd">
<msxconfig>
  <info>
    <manufacturer>C-BIOS</manufacturer>
    <code>C-BIOS_R800_V9968_Geo3D</code>
    <release_year>2005</release_year>
    <description>Synthetic C-BIOS/R800/S1990/V9968/Geo3D test profile; not a Panasonic BIOS validation. Use enable_cbios_r800.tcl.</description>
    <type>MSXturboR</type>
    <region>int</region>
  </info>
  <MapperReadBackBits>largest</MapperReadBackBits>
  <CassettePort />
  <devices>
    <primary slot="0">
      <ROM id="C-BIOS Main ROM">
        <mem base="0x0000" size="0x8000" />
        <rom>
          <sha1>eedb8e7fa7a3add746b76a87077b3af8c2fc07aa</sha1>
          <filename>cbios_main_msx2+.rom</filename>
        </rom>
      </ROM>
      <ROM id="C-BIOS Logo ROM">
        <mem base="0x8000" size="0x4000" />
        <rom>
          <sha1>db2635ef7e3f8589518dca65f2e3b515edc5372d</sha1>
          <filename>cbios_logo_msx2+.rom</filename>
        </rom>
      </ROM>
    </primary>
    <primary external="true" slot="1" />
    <primary external="true" slot="2" />
    <primary slot="3">
      <secondary slot="1">
        <ROM id="C-BIOS Sub ROM">
          <mem base="0x0000" size="0x4000" />
          <rom>
            <sha1>2fcb40413e7d373f0f2dbdc815ce18746ddf3684</sha1>
            <filename>cbios_sub.rom</filename>
          </rom>
        </ROM>
      </secondary>
      <secondary slot="2">
        <MSX-MUSIC id="C-BIOS MSX-MUSIC">
          <mem base="0x4000" size="0x4000" />
          <io base="0x7C" num="2" type="O" />
          <rom>
            <sha1>5c5eb001e6a1fe29edb7abd428a3967bb388e5db</sha1>
            <filename>cbios_music.rom</filename>
          </rom>
          <sound><volume>9000</volume></sound>
        </MSX-MUSIC>
      </secondary>
      <secondary slot="0">
        <PanasonicRAM id="Main RAM">
          <mem base="0x0000" size="0x10000" />
          <size>512</size>
        </PanasonicRAM>
      </secondary>
    </primary>
    <PPI id="ppi">
      <io base="0xA8" num="4" />
      <sound><volume>16000</volume></sound>
      <key_ghosting>false</key_ghosting>
      <keyboard_type>int</keyboard_type>
      <has_keypad>true</has_keypad>
      <code_kana_locks>false</code_kana_locks>
      <graph_locks>false</graph_locks>
    </PPI>
    <VDP id="VDP">
      <io base="0x98" num="5" type="O" />
      <io base="0x98" num="5" type="I" />
      <version>V9968</version>
      <vram>128</vram>
      <timing>0</timing>
    </VDP>
    <PSG id="PSG">
      <type>YM2149</type>
      <io base="0xA0" num="4" type="IO" />
      <sound><volume>21000</volume></sound>
    </PSG>
    <RTC id="Real time clock">
      <io base="0xB4" num="2" type="O" />
      <io base="0xB5" num="1" type="I" />
      <sramname>cbios-msx2+.cmos</sramname>
    </RTC>
    <PrinterPort id="Printer Port"><io base="0x90" num="2" /></PrinterPort>
    <ResetStatusRegister id="Reset Status register">
      <io base="0xF4" num="1" />
      <inverted>true</inverted>
    </ResetStatusRegister>
    <S1990 id="S1990"><io base="0xE4" num="2" /></S1990>
    <E6Timer id="Turbo-R timer"><io base="0xE6" num="2" /></E6Timer>
    <Geo3D id="Geo3D">
      <io base="0x9D" num="1" />
      <io base="0x9F" num="1" />
      <vdp>VDP</vdp>
    </Geo3D>
  </devices>
</msxconfig>
