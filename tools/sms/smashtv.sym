; Smash T.V. (Europe) Master System - symbol table. Format: ADDR name ; comment
; Confidence tags: [C] confirmed by reading code and/or runtime observation, [H] hypothesis.
; Slot-2 addresses ($8000-$BFFF) are bank 2, which the game keeps mapped during play.

; ---- code: boot / interrupts / frame sync ----
0000 reset                    ; DI, IM 1, JP boot [C]
0038 irq_vector               ; JP isr_vblank [C]
0066 nmi_pause                ; Pause button: toggles D038 and spins until pressed again [C]
15D5 boot                     ; SP=D1B2, mapper init, copy $0400->C000 ($11B4 bytes), VDP init, main entry [C]
160B isr_vblank               ; ack VDP, ++C1EA, reset check, set D02D, --C223, call sound_tick [C]
164B soft_reset               ; reset-button path [C]
165D vdp_init_regs             ; writes 18 (value,reg) pairs from vdp_reg_table [C]
166B vdp_reg_table            ; [C]
2731 wait_frame_paced         ; waits VBlanks until C223 (ISR-decremented) hits 0, reloads 3: game loop runs at 1/3 VBlank rate [C]
19C9 wait_vblank              ; EI; D02D=0; spin until D02D != 0 [C]
167D wait_frames_a            ; delay A frames, aborts when a button pressed (D039 bit0) [C]
16AA wait_frames_noskip       ; [C]

; ---- VDP helpers ----
16BC vdp_set_reg_hl           ; out L then H (register write form) [C]
16CD vdp_set_write_addr       ; HL = VRAM address (H|$40) [C]
16E0 vdp_set_reg              ; H=|$80 register write [C]
16F3 vdp_write_cram_byte      ; set CRAM addr, write L [C]
182C vdp_load_palette         ; writes 32 CRAM bytes from HL [C]
1756 load_tiles_desc          ; uploads tile data described by asset descriptor IX to VRAM at C1E3 [C]
17C3 load_tiles_fixed         ; same, fixed 12*64 bytes [C]
1966 draw_tilemap_desc        ; draws descriptor IX map into name table $3800 [C]
194C clear_nametable          ; [C]
19D6 palette_fade             ; fade palette towards table in HL [C]
2701 oam_upload               ; C000->VRAM $3F00 (Y), C080->$3F80 (X,tile) [C]
26BC oam_prepare              ; [H]
442F vram_queue_flush         ; plays back queued VRAM writes at C5B8 during VBlank [C]
656E vram_queue_addr          ; queue "set VRAM address HL" [C]
6588 vram_queue_byte_b        ; [C]
659A vram_queue_byte_a        ; [C]
6144 draw_text                ; DE=string -> name table (text/HUD) [H]

; ---- input ----
7A20 read_input               ; ports $DC/$DD -> C1F1 (P1) / C1F2 (P2); demo AI when D03A != 0 [C]
7A5A input_mask_opposites     ; cancels up+down / left+right [C]
7A77 demo_autoplay            ; attract-mode pilot for players [C]
3334 check_button_skip        ; any fire button sets D039 bit0 [C]
0210 debug_nibble_read        ; leftover dev-cart serial monitor over joypad port (unused in play) [C]

; ---- game loop / flow ----
2025 play_room                ; per-room function: setup, loop 2050..2169, returns A=0 [C]
2050 room_loop                ; [C]
21E2 init_game_ram            ; LDIR $0400->C000 FE2 bytes, copy options to players [C]
57BF main_flow                ; title/attract flow loop [C]
57F0 script_step              ; room script VM step: opcode table at 5819 [C]
581A script_op_table          ; word per opcode, dispatched by script_step [C]
76C3 tick_counter             ; ++C1ED; C1F3 = n xor (n-1) (phase mask) [C]
76E0 low_health_beep          ; [H]
252C rng                      ; A = R + C247 accumulate (LD A,R based) [C]

; ---- players / combat ----
770C player_update            ; for IX in C501,C518 [C]
2F3A player_vs_enemy_collide  ; AABB player box vs enemy pool; damage, death states [C]
3307 player_misc_update       ; [H]
334D player_fire              ; fire handling per player (calls 336C) [C]
336C player_spawn_shot        ; weapon-dependent shot spawn into projectile pool [C]
36F1 proj_find_free           ; HL = free projectile slot (Z set) [C]
373F projectile_draw          ; projectile/pickup -> asset descriptors [C]
4890 bullets_vs_enemies       ; projectile pool vs enemy pool collisions [C]
48C9 bullet_hit_test          ; [C]
32DC add_score                ; B=player, C=points index; 3-byte BCD add [C]
3291 set_arena_bounds         ; C2B4..C2B7 playfield limits [C]
A12A enemy_ai_dispatch        ; per slot jump through enemy_ai_table [C]
A164 enemy_ai_table           ; 19 words, types 0..18 [C]
A18E enemy_move_dirbits       ; moves slot by dir bits (+0x60) 4px with 4D4D check [C]
A2AA enemy_aim_at_player      ; computes dir bits toward target player [C]
4D4D enemy_move_blocked       ; entity-vs-entity/wall check used by movement [H]
4CB4 enemies_clear            ; [C]
4CDB projectiles_prune        ; keeps types 6..12 only [C]
4354 enemies_draw             ; enemy slot -> asset descriptor (table CFBC by type) -> draw [C]
69EE enemy_death_fx           ; [H]

; ---- sound ----
9BFF music_play               ; A = track (0 = stop), honours D030 [C]
9BD6 sfx_play                 ; A = sfx id, priority via C292 and table 9C13, honours D031 [C]
B936 sound_cmd                ; [H]
BA09 sound_tick               ; called from ISR each frame [C]

; ---- RAM ----
C000 sat_y                    ; 64 sprite Y shadow -> VRAM $3F00 [C]
C080 sat_xn                   ; 64 x (X,tile) pairs -> VRAM $3F80 [C]
C0C0 palette_scratch          ; 32 bytes, reused for fades [C]
C1E3 vram_tile_cursor         ; word, next free tile byte offset in VRAM [C]
C1EA isr_frame_counter        ; ++ each VBlank [C]
C1EB room_ptr                 ; word, current room descriptor [C]
C1ED tick_counter_w           ; word, ++ per game loop pass [C]
C1F0 game_flags               ; bit0 combat active, bit2 exit open? [H]
C1F1 pad_p1                   ; b0 up,b1 down,b2 left,b3 right,b4 btn1,b5 btn2 (1=pressed) [C]
C1F2 pad_p2                   ; [C]
C1F3 tick_phase               ; n xor (n-1): bit k set every 2^k ticks [C]
C1F6 tilemap_attr             ; OR'd into name-table high byte (priority) [C]
C208 script_pc                ; word [C]
C20A script_wait              ; word [C]
C221 ai_step                  ; toggles each pass, AI runs on one phase [C]
C222 ai_slot                  ; slot index while AI loops [C]
C223 pacing_timer             ; --'d by ISR and wait_vblank_timer [C]
C226 score_p1                 ; 3 bytes BCD little-endian [C]
C229 score_p2                 ; 3 bytes BCD little-endian [C]
C247 rng_state                ; [C]
C25A vram_queue_ptr           ; word [C]
C292 sfx_priority             ; [C]
C2B4 arena_bound_0            ; [C]
C2B5 arena_bound_1            ; [C]
C2B6 arena_bound_2            ; [C]
C2B7 arena_bound_3            ; [C]
C2B9 effects_list             ; 20-byte list [H]
C391 proj_type                ; projectile/pickup pool, 16 slots, struct-of-arrays [C]
C481 enemy_type               ; enemy pool, 16 slots, struct-of-arrays [C]
C501 player1                  ; 23-byte player struct [C]
C510 player1_lives            ; [C]
C515 player1_active           ; [C]
C518 player2                  ; [C]
C527 player2_lives            ; [C]
C52C player2_active           ; [C]
C5B8 vram_queue               ; VRAM write queue [C]
C9B8 asset_descriptors        ; 22-byte records (x,y,w,h,frame,size,src,bank,map,tile base) [C]
CFBC enemy_desc_ptr_table     ; word per type -> descriptor [C]
CFE2 points_table             ; 3-byte BCD per kill type [C]
D02D vblank_flag              ; set by ISR [C]
D02E wait_scale               ; [H]
D030 opt_music_off            ; 1 = music muted [C]
D031 opt_sfx_off              ; 1 = effects muted [C]
D033 start_room_ptr           ; word [C]
D035 opt_cheat_lives          ; nonzero keeps lives at 6 [C]
D036 opt_p1                   ; [H]
D037 opt_p2                   ; [H]
D038 pause_flag               ; [C]
D039 screen_state             ; bit0 skip requested, bit1 block skip [C]
D03A input_mode               ; 0 live input, nonzero demo (2 = ended) [C]
D03B demo_timer               ; ends demo at $A0 [C]
D400 snd_channel0             ; 6 channel structs, $21 bytes each [H]
D4C7 snd_global               ; [H]
