+  ld a,#0x91
+  out (0x99),a
+  ld a,0 (ix)
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  ld a,1 (ix)
+  out (0x9B),a
+  ld a,2 (ix)
+  out (0x9B),a
+  ld a,e
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  ld a,d
+  out (0x9B),a
