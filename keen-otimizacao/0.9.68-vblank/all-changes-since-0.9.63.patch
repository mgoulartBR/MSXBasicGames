+  ld a,5 (ix)
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  ld a,#8
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  out (0x9B),a
+  out (0x9B),a
