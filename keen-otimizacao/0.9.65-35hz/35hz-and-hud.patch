+// Z80 fast path for HudDraw's per-frame cache copies (see HudDraw). Parameters travel on the
+// caller's stack (persistent RAM is full). Returns 1 if every chunk was issued, 0 if any chunk
+// wraps the 256x256 ring (the generic loop in HudDraw then does the work).
+typedef struct {const HudChunk* p;u8 n,hx,hy,mlo,mhi,page;} HudFastArgs;
+static u8 HudFast(HudFastArgs* args) __sdcccall(1) __naked
+{
+ args;
+ __asm
+  push ix
+  push iy
+  push hl
+  pop iy
+  ld l,0 (iy)
+  ld h,1 (iy)
+  push hl
+  pop ix
+  ld b,2 (iy)
+hf_loop:
+  ld a,4 (ix)
+  cp #16
+  ld a,5 (iy)
+  jr c,hf_chk
+  ld a,6 (iy)
+hf_chk:
+  or a
+  jp z,hf_next
+  ld a,3 (iy)
+  add a,3 (ix)
+  ld e,a
+  ld a,5 (ix)
+  add a,e
+  jr nc,hf_xok
+  or a
+  jp nz,hf_fail
+hf_xok:
+  ld a,4 (iy)
+  add a,4 (ix)
+  ld d,a
+  add a,#8
+  jr nc,hf_yok
+  or a
+  jp nz,hf_fail
+hf_yok:
+  call _VDP_CommandWait
+  di
+  ld a,#32
+  out (0x99),a
+  ld a,#0x91
+  out (0x99),a
+  ld a,0 (ix)
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  ld a,1 (ix)
+  out (0x9B),a
+  ld a,2 (ix)
+  out (0x9B),a
+  ld a,e
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  ld a,d
+  out (0x9B),a
+  ld a,7 (iy)
+  out (0x9B),a
+  ld a,5 (ix)
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  ld a,#8
+  out (0x9B),a
+  xor a
+  out (0x9B),a
+  out (0x9B),a
+  out (0x9B),a
+  ld a,e
+  or 5 (ix)
+  and #1
+  ld a,#0xD0
+  jr z,hf_cmd
+  ld a,#0x90
+hf_cmd:
+  ei
+  out (0x9B),a
+hf_next:
+  ld de,#7
+  add ix,de
+  dec b
+  jp nz,hf_loop
+  ld a,#1
+  jr hf_done
+hf_fail:
+  xor a
+hf_done:
+  pop iy
+  pop ix
+  ret
+ __endasm;
+}
